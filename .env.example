# ============================================================
# GymSync V1 — Variables de Entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# ── Base de datos ────────────────────────────────────────────
# URL completa de conexión a PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://gymsync:gymsync_dev_password@localhost:5432/gymsync_db"

# ── Autenticación JWT ────────────────────────────────────────
# Clave secreta para firmar tokens JWT.
# PRODUCCIÓN: mínimo 64 caracteres aleatorios. Genera con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CAMBIA_ESTO_EN_PRODUCCION_minimo_32_caracteres_aleatorios"

# Duración del access token (formato: https://github.com/vercel/ms)
JWT_EXPIRES_IN="15m"

# ── Servidor ─────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"

# ── CORS ─────────────────────────────────────────────────────
# URL del frontend. En desarrollo: http://localhost:5173
# En producción: https://tudominio.com
CORS_ORIGIN="http://localhost:5173"

# ── Rate Limiting ─────────────────────────────────────────────
# Ventana en minutos para rate limiting del endpoint de login
RATE_LIMIT_WINDOW_MS="900000"
# Máximo de intentos por ventana
RATE_LIMIT_MAX="5"

# ── PostgreSQL (solo para Docker Compose) ────────────────────
POSTGRES_USER="gymsync"
POSTGRES_PASSWORD="gymsync_dev_password"
POSTGRES_DB="gymsync_db"
POSTGRES_PORT="5432"

# ── Frontend (Vite — deben tener prefijo VITE_) ──────────────
VITE_API_URL="http://localhost:3000/api/v1"
VITE_APP_NAME="GymSync"
